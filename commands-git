# Cloner un repository :
git clone adresse URL du repository qu'on a sur github
cd nom du porjet qu'on trouve sur l'adresse URL


# Les 3 commandes de push : 
git add .
git commit -m "message"
git push

# Commande pour pull :
git pull (on va avoir les changements qu'on a fait sur Github sur Git)

# Commande pour créer nouvelle branche :
git branch nom nouvelle branche

# Commande pour aller sur cette branche :
git switch nom nouvelle branche
